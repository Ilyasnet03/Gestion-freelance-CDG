# Base de données PostgreSQL
POSTGRES_DB=freelances
POSTGRES_USER=app
POSTGRES_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# Spring Boot Sécurité & JWT
JWT_SECRET=your_base64_or_hex_encoded_secret_key_minimum_256_bits
JWT_EXPIRATION_MS=86400000

# Clé API Interne Spring Boot <-> FastAPI
INTERNAL_API_KEY=cdg-internal-secret-api-key-2026

# URLs de communication
SPRING_BOOT_PORT=8080
FASTAPI_PORT=8000
FASTAPI_BASE_URL=http://localhost:8000
ANALYTICS_DAILY_CRON=0 0 2 * * *
FRONTEND_PORT=4200
FRONTEND_ORIGIN=http://localhost:4200

# SonarQube local
SONARQUBE_PORT=9000
SONARQUBE_DB=sonarqube26
SONARQUBE_DB_USER=sonarqube
SONARQUBE_DB_PASSWORD=sonarqube
